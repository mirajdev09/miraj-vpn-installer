
#!/bin/bash
set -Eeuo pipefail

echo "================================"
echo " MIRAJ VPN - UBUNTU AIO"
echo "================================"

if [ "$EUID" -ne 0 ]; then
    echo "Run as root."
    exit 1
fi

source /etc/os-release

if [[ "$ID" != "ubuntu" || "$VERSION_ID" != "24.04" ]]; then
    echo "Only Ubuntu 24.04 is supported."
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y curl wget git ca-certificates \
    openssl jq unzip tar

echo "Ubuntu 24.04 preparation completed."
echo "VPN installation is not enabled yet."
