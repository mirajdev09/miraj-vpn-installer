
#!/bin/bash
set -Eeuo pipefail

echo "Ubuntu AIO installer started"
echo "Checking operating system..."

if [ ! -f /etc/os-release ]; then
    echo "OS information not found."
    exit 1
fi

. /etc/os-release

if [[ "$ID" != "ubuntu" ]]; then
    echo "This installer supports Ubuntu only."
    exit 1
fi

if [[ "$VERSION_ID" != "24.04" ]]; then
    echo "Ubuntu 24.04 is required."
    exit 1
fi

apt-get update
apt-get install -y curl wget git ca-certificates

echo "Basic preparation completed."
echo "VPN services are not installed yet."
